    "dailyCap": { "searches": 150, "placePages": 900 },
    "limitedViewStreakStop": 5,
    "maxScrolls": 30,
    "blockBackoffMinutes": 60,
    "smokeBudget": { "searches": 3, "placePages": 6 },
